/* ===== WINDOW LAYOUT ===== */
.editor-layout {
    flex-grow: 1;
}

/* ===== TYPE LIST PANEL ===== */
.type-list {
    width: 180px;
    flex-shrink: 0;
    border-right-width: 1px;
    border-right-color: #252525;
}

.type-search-field {
    margin-left: 6px;
    margin-right: 6px;
    margin-top: 6px;
    margin-bottom: 6px;
}

/* ===== WORKSPACE + TABS ===== */
.workspace {
    flex-grow: 1;
    flex-direction: column;
    min-width: 0;
}

.tab-strip {
    height: 34px;
    flex-direction: row;
    align-items: flex-end;
    padding-left: 8px;
    padding-right: 8px;
    border-bottom-width: 1px;
    border-bottom-color: #2e2e2e;
}

.tab {
    width: 100%;
    height: 28px;
    margin-right: 4px;
}

.tab--active {
    background-color: #3c3c3c;
}

.tab-button {
    height: 28px;
    width: 100%;
    align-items: flex-end;
}

.tab-close-button {
    width: 20px;
    margin-left: 6px;
}

.tab-content {
    flex-grow: 1;
    min-height: 0;
}

/* ===== DATA EDITOR ROOT ===== */
.data-editor-view {
    flex-grow: 1;
    flex-direction: column;
    min-height: 0;
}

/* ===== DATA EDITOR TOOLBAR ===== */
.search-actions-row {
    height: 36px;
    flex-direction: row;
    align-items: center;
    padding-left: 8px;
    padding-right: 8px;
    border-bottom-width: 1px;
    border-bottom-color: #2e2e2e;
}

.search-field {
    flex-grow: 1;
    margin-right: 8px;
}

.action-buttons {
    flex-direction: row;
    flex-shrink: 0;
}

.action-buttons Button {
    margin-left: 4px;
}

.view-mode-menu {
    width: 120px;
    margin-right: 4px;
}

.field-visibility-menu {
    width: 120px;
    margin-right: 4px;
}

/* ===== FILTER MODULE ===== */
.filter-panel {
    flex-direction: column;
    padding: 8px;
    border-bottom-width: 1px;
    border-bottom-color: #2e2e2e;
}

.filter-toolbar {
    flex-direction: row;
    align-items: center;
}

.filter-toolbar > * {
    margin-right: 6px;
}

.filter-mode-menu {
    width: 140px;
}

.filter-conditions {
    margin-top: 6px;
    flex-direction: column;
}

.filter-condition-row {
    flex-direction: row;
    align-items: center;
    margin-top: 4px;
}

.filter-field-menu {
    width: 180px;
    margin-right: 6px;
}

.filter-op-menu {
    width: 60px;
    margin-right: 6px;
}

.filter-value-field {
    flex-grow: 1;
    margin-right: 6px;
}

.filter-remove-button {
    width: 24px;
}

/* ===== DATA EDITOR CONTENT ===== */
.editor-body-host {
    flex-grow: 1;
    min-height: 0;
}

.editor-split-view {
    flex-grow: 1;
    min-height: 0;
    flex-direction: row;
}

.editor-split-table {
    flex-grow: 1;
    min-width: 0;
}

.editor-detail-pane {
    width: 380px;
    flex-shrink: 0;
    border-left-width: 1px;
    border-left-color: #2e2e2e;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 8px;
    padding-bottom: 8px;
}

.editor-detail-header {
    font-size: 14px;
    -unity-font-style: bold;
    margin-bottom: 8px;
}

.editor-table-summary {
    unity-text-align: middle-left;
    color: #c8c8c8;
    padding-left: 4px;
    padding-right: 4px;
}

.editor-body-item {
    margin-top: 50px;
    margin-bottom: 50px;

    padding-top: 5px;
    padding-bottom: 5px;

    border-top-width: 2px;
    border-bottom-width: 2px;

    border-color: #2e2e2e;
}

.editor-body-item-label{
    padding-left: 5px;
    padding-bottom: 5px;
    padding-top: 5px;
    
    font-size: 16px;
}

/* ===== TYPE LIST ITEMS ===== */
.type-item {
    flex-direction: row;
    align-items: center;

    height: 28px;
    padding-left: 8px;
    padding-right: 8px;

    border-bottom-width: 1px;
    border-bottom-color: #2e2e2e;
}

.type-item:hover {
    background-color: #2e2e2e;
}

.type-tree-prefix {
    flex-shrink: 0;
    font-size: 12px;
}

.type-label {
    flex-grow: 1;
    font-size: 12px;
}

.type-folder-item .type-label {
    -unity-font-style: bold;
}

.type-folder-rename {
    flex-grow: 1;
    font-size: 12px;
    margin-right: 4px;
}

.type-fold-toggle {
    width: 18px;
    min-width: 18px;
    margin-right: 4px;
}

.type-count {
    font-size: 15px;
    color: #cfcfcf;

    background-color: #3a3a3a;
    padding-left: 6px;
    padding-right: 6px;
    border-radius: 8px;

    -unity-text-align: middle-right;
}
